# ============================================
# DeepTutor Environment Template
# ============================================
# Copy this file to `.env` and fill in your values.
# Core runtime settings are grouped as:
# ports / llm / embedding / search / database / auth / billing / docker-cloud / security

# --------------------------------------------
# Ports
# --------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=3782

# --------------------------------------------
# LLM (Required)
# --------------------------------------------
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxx
LLM_HOST=https://api.openai.com/v1
LLM_API_VERSION=

# --------------------------------------------
# Embedding (Required for knowledge base features)
# --------------------------------------------
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_HOST=https://api.openai.com/v1
EMBEDDING_DIMENSION=3072
EMBEDDING_API_VERSION=

# --------------------------------------------
# Web Search (Optional)
# --------------------------------------------
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=

# --------------------------------------------
# Database (Required for SaaS mode)
# --------------------------------------------
# PostgreSQL (recommended for production):
DATABASE_URL=postgresql+asyncpg://deeptutor:deeptutor@localhost:5432/deeptutor
# SQLite (for local/single-user mode):
# DATABASE_URL=sqlite+aiosqlite:///./data/deeptutor.db

# Optional: database pool tuning
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_ECHO=false

# --------------------------------------------
# Authentication (Required for SaaS mode)
# --------------------------------------------
# Change this in production! Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-change-in-production
# Token expiry (seconds)
JWT_ACCESS_EXPIRE=3600
JWT_REFRESH_EXPIRE=2592000
# Set to false for local/dev to skip auth on all endpoints
AUTH_REQUIRED=true

# --------------------------------------------
# Billing / Stripe (Optional)
# --------------------------------------------
# Leave empty to run in free-tier-only mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------
# Email / SMTP (Optional, for magic links & notifications)
# --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@deeptutor.ai

# --------------------------------------------
# Docker / Cloud deployment (Optional)
# --------------------------------------------
# Public backend URL used by the frontend when deployed remotely.
NEXT_PUBLIC_API_BASE_EXTERNAL=
# Alternative direct API base URL.
NEXT_PUBLIC_API_BASE=

# --------------------------------------------
# Security / Networking (Optional)
# --------------------------------------------
# Keep this false in production.
DISABLE_SSL_VERIFY=false
# Comma-separated list of allowed frontend origins for CORS. Required for any
# non-local deployment — without it the API only trusts localhost:FRONTEND_PORT.
# Example: CORS_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ORIGINS=
